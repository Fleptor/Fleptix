<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fleptix Observer</title>
    <meta name="description" content="Fleptix Observer - Operational Container Telemetry & Management" />
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Chart.js & SignalR Client -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <!-- Google Fonts: JetBrains Mono & Fira Code -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Fleptix Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Synchronous Theme, Font Scale & CLI Console Loader (Prevents FOUC) -->
    <script>
        (function() {
            try {
                var theme = localStorage.getItem('fleptix_theme') || 'system';
                var effectiveTheme = theme;
                if (theme === 'system') {
                    effectiveTheme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-theme', effectiveTheme);

                var fontSize = localStorage.getItem('fleptix_font_size') || 'default';
                document.documentElement.setAttribute('data-font-size', fontSize);

                var cliBg = localStorage.getItem('fleptix_cli_bg') || '#0a0e17';
                var cliFg = localStorage.getItem('fleptix_cli_fg') || '#e2e8f0';
                var cliFont = localStorage.getItem('fleptix_cli_font') || "'JetBrains Mono', monospace";
                document.documentElement.style.setProperty('--cli-bg', cliBg);
                document.documentElement.style.setProperty('--cli-fg', cliFg);
                document.documentElement.style.setProperty('--cli-font', cliFont);
            } catch (e) {
                console.error('Theme/Font/CLI initialization error:', e);
            }
        })();
    </script>
</head>
<body class="fleptix-app">
    <div class="app-layout">
        <!-- Persistent Left Sidebar -->
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <a href="/" class="brand-link">
                    <span class="brand-mark"><i class="bi bi-layers-fill"></i></span>
                    <span class="brand-text">Fleptix</span>
                </a>
                <span class="brand-badge">Observer</span>
            </div>

            <nav class="sidebar-nav">
                <a href="/" class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" || ViewContext.RouteData.Values["page"] == null ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/Containers" class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Containers" ? "active" : "")">
                    <i class="bi bi-box-seam"></i>
                    <span>Containers</span>
                </a>
                <a href="/Deploy" class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Deploy" ? "active" : "")">
                    <i class="bi bi-rocket-takeoff"></i>
                    <span>Deploy</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <a href="/Settings" class="nav-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Settings" ? "active" : "")">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="app-main">
            @{
                var pageRoute = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                var isContainers = pageRoute == "/Containers";
            }
            @if (isContainers)
            {
                <!-- Minimal Top Bar: Centered on Containers list page only -->
                <header class="app-topbar topbar-centered">
                    <div class="topbar-search">
                        <i class="bi bi-search search-icon"></i>
                        <input type="search" id="globalSearchInput" class="topbar-search-input" placeholder="Search containers, images, ports... (Press '/' to focus)" />
                    </div>
                </header>
            }

            <!-- Main Page Content -->
            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="fleptixToast" class="toast align-items-center text-dark bg-white border shadow-sm" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2" id="toastMessage">
                    <i class="bi bi-info-circle text-primary"></i> Action completed.
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global Keyboard Shortcut for Search ('/')
        document.addEventListener('keydown', (e) => {
            if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
                e.preventDefault();
                document.getElementById('globalSearchInput')?.focus();
            }
        });

        // Toast Helper
        window.showToast = function(message, isError = false) {
            const toastEl = document.getElementById('fleptixToast');
            const toastBody = document.getElementById('toastMessage');
            if (toastEl && toastBody) {
                toastBody.innerHTML = isError 
                    ? `<i class="bi bi-exclamation-triangle-fill text-danger"></i> <span>${message}</span>`
                    : `<i class="bi bi-check-circle-fill text-success"></i> <span>${message}</span>`;
                const toast = new bootstrap.Toast(toastEl, { delay: 3500 });
                toast.show();
            }
        };

        // Engine Daemon Connectivity & Reconnect Handling
        function updateDaemonStatusUI(isConnected, endpoint, error) {
            const banner = document.getElementById('daemonDisconnectedBanner');
            const bannerDetails = document.getElementById('daemonBannerDetails');

            if (isConnected) {
                if (banner) { banner.style.display = 'none'; }
            } else {
                if (banner) {
                    banner.style.display = 'flex';
                    if (bannerDetails && error) {
                        bannerDetails.textContent = `Cannot connect to Docker daemon at ${endpoint || 'socket'}. Error: ${error}. Verify Docker socket mount and permissions.`;
                    }
                }
            }
        }

        async function checkEngineStatus() {
            try {
                const res = await fetch('/api/system/status');
                if (res.ok) {
                    const data = await res.json();
                    updateDaemonStatusUI(data.isConnectedToDocker, data.endpoint, data.lastError);
                }
            } catch (err) {
                console.error("Failed to check engine status:", err);
                updateDaemonStatusUI(false, '', err.message);
            }
        }

        window.retryDaemonConnection = async function() {
            window.showToast('Probing Docker daemon connection...');
            try {
                const res = await fetch('/api/system/retry-connection', { method: 'POST' });
                if (res.ok) {
                    const data = await res.json();
                    updateDaemonStatusUI(data.isConnectedToDocker, data.endpoint, data.lastError);
                    if (data.isConnectedToDocker) {
                        window.showToast('Successfully connected to Docker Engine');
                        setTimeout(() => window.location.reload(), 500);
                    } else {
                        window.showToast(`Connection failed: ${data.lastError || 'Daemon unreachable'}`, true);
                    }
                }
            } catch (err) {
                window.showToast('Failed to contact server: ' + err.message, true);
            }
        };

        // ==========================================
        // Global Theme & Font Scale Management
        // ==========================================
        window.getStoredTheme = function() {
            return localStorage.getItem('fleptix_theme') || 'system';
        };

        window.getEffectiveTheme = function() {
            const stored = window.getStoredTheme();
            if (stored === 'system') {
                return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
            }
            return stored;
        };

        window.setTheme = function(mode) {
            localStorage.setItem('fleptix_theme', mode);
            const effective = (mode === 'system')
                ? ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light')
                : mode;
            document.documentElement.setAttribute('data-theme', effective);
            window.syncThemeUI();
        };

        window.toggleQuickTheme = function() {
            const current = window.getEffectiveTheme();
            const next = (current === 'dark') ? 'light' : 'dark';
            window.setTheme(next);
        };

        window.setFontSize = function(size) {
            localStorage.setItem('fleptix_font_size', size);
            document.documentElement.setAttribute('data-font-size', size);
            window.syncFontSizeUI();
        };

        window.syncThemeUI = function() {
            const stored = window.getStoredTheme();
            const radioLight = document.getElementById('themeRadioLight');
            const radioDark = document.getElementById('themeRadioDark');
            const radioSystem = document.getElementById('themeRadioSystem');
            if (radioLight) radioLight.checked = (stored === 'light');
            if (radioDark) radioDark.checked = (stored === 'dark');
            if (radioSystem) radioSystem.checked = (stored === 'system');
        };

        window.syncFontSizeUI = function() {
            const size = localStorage.getItem('fleptix_font_size') || 'default';
            const radioCompact = document.getElementById('fontScaleCompact');
            const radioDefault = document.getElementById('fontScaleDefault');
            const radioLarge = document.getElementById('fontScaleLarge');
            if (radioCompact) radioCompact.checked = (size === 'compact');
            if (radioDefault) radioDefault.checked = (size === 'default');
            if (radioLarge) radioLarge.checked = (size === 'large');
        };

        // ==========================================
        // CLI Windows Customization Management
        // (Live Logs, Daemon Streams, Exec Shell)
        // ==========================================
        window.setCliBg = function(color) {
            localStorage.setItem('fleptix_cli_bg', color);
            document.documentElement.style.setProperty('--cli-bg', color);
            window.syncCliUI();
        };

        window.setCliFg = function(color) {
            localStorage.setItem('fleptix_cli_fg', color);
            document.documentElement.style.setProperty('--cli-fg', color);
            window.syncCliUI();
        };

        window.setCliFont = function(font) {
            localStorage.setItem('fleptix_cli_font', font);
            document.documentElement.style.setProperty('--cli-font', font);
            window.syncCliUI();
        };

        window.resetCliSettings = function() {
            localStorage.removeItem('fleptix_cli_bg');
            localStorage.removeItem('fleptix_cli_fg');
            localStorage.removeItem('fleptix_cli_font');
            document.documentElement.style.setProperty('--cli-bg', '#0a0e17');
            document.documentElement.style.setProperty('--cli-fg', '#e2e8f0');
            document.documentElement.style.setProperty('--cli-font', "'JetBrains Mono', monospace");
            window.syncCliUI();
            if (typeof window.showToast === 'function') {
                window.showToast('CLI terminal styles reset to defaults.');
            }
        };

        window.syncCliUI = function() {
            const bg = localStorage.getItem('fleptix_cli_bg') || '#0a0e17';
            const fg = localStorage.getItem('fleptix_cli_fg') || '#e2e8f0';
            const font = localStorage.getItem('fleptix_cli_font') || "'JetBrains Mono', monospace";

            const inputBg = document.getElementById('cliBgPicker');
            const inputBgText = document.getElementById('cliBgText');
            const inputFg = document.getElementById('cliFgPicker');
            const inputFgText = document.getElementById('cliFgText');
            const selectFont = document.getElementById('cliFontSelect');
            const previewBox = document.getElementById('cliPreviewWindow');

            if (inputBg) inputBg.value = bg.startsWith('#') && bg.length === 7 ? bg : '#0a0e17';
            if (inputBgText) inputBgText.value = bg;
            if (inputFg) inputFg.value = fg.startsWith('#') && fg.length === 7 ? fg : '#e2e8f0';
            if (inputFgText) inputFgText.value = fg;
            if (selectFont) selectFont.value = font;
            if (previewBox) {
                previewBox.style.setProperty('background-color', bg, 'important');
                previewBox.style.setProperty('color', fg, 'important');
                previewBox.style.setProperty('font-family', font, 'important');
            }
        };

        if (window.matchMedia) {
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
                if (window.getStoredTheme() === 'system') {
                    document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
                    window.syncThemeUI();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            window.syncThemeUI();
            window.syncFontSizeUI();
            window.syncCliUI();
        });

        checkEngineStatus();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
