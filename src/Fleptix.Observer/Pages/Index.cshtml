@page
@model Fleptix.Observer.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var runningCount = Model.Containers.Count(c => c.State == "running");
    var pausedCount = Model.Containers.Count(c => c.State == "paused");
    var stoppedCount = Model.Containers.Count(c => c.State == "exited" || c.State == "created");
    var totalContainers = Math.Max(1, Model.Containers.Count);
    var runningPct = Math.Round(((double)runningCount / totalContainers) * 100.0, 1);
    var stoppedPct = Math.Round(((double)stoppedCount / totalContainers) * 100.0, 1);
    var pausedPct = Math.Round(((double)pausedCount / totalContainers) * 100.0, 1);

    var stackCount = Model.Containers.Any() 
        ? Model.Containers.Select(c => c.Name.Contains('_') ? c.Name.Split('_')[0] : (c.Name.Contains('-') ? c.Name.Split('-')[0] : "standalone")).Distinct().Count()
        : 0;
    
    double initialCpu = 0;
    ulong initialMemBytes = 0;
    foreach(var m in Model.InitialMetrics.Values)
    {
        initialCpu += m.CpuPercentage;
        initialMemBytes += m.MemoryUsageBytes;
    }
    var initialMemMb = Math.Round(initialMemBytes / (1024.0 * 1024.0), 1);
    var priorityContainers = Model.Containers
        .OrderByDescending(c => c.State != "running")
        .ThenBy(c => c.Name)
        .Take(6)
        .ToList();
}


<div class="container-fluid p-0">
    @if (!Model.IsConnectedToDocker)
    {
        <div class="alert alert-danger py-2 px-3 d-flex align-items-center justify-content-between font-mono mb-3" style="font-size: 12px;" id="daemonDisconnectedBanner">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-octagon-fill text-danger fs-6"></i>
                <div>
                    <strong>Docker Daemon Offline</strong> &mdash;
                    <span id="daemonBannerDetails">Cannot connect to Docker daemon at @Model.DaemonEndpoint. @(Model.LastConnectionError ?? "Verify socket mount and permissions.")</span>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-danger font-mono py-0 px-2" onclick="retryDaemonConnection()" id="btnRetryDaemon">
                <i class="bi bi-arrow-repeat"></i> Retry
            </button>
        </div>
    }

    <!-- Top Operational Telemetry Bar (4-Card Metric Grid) -->
    <div class="row g-3 mb-3">
        <!-- Card 1: Container Fleet -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="bg-white border rounded p-3 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam text-secondary fs-6"></i>
                            <span class="text-uppercase fw-semibold text-muted" style="font-size: 11px; letter-spacing: 0.04em;">Container Fleet</span>
                        </div>
                        <span class="font-mono text-muted" style="font-size: 11px;" id="dashFleetStacks">@stackCount stacks</span>
                    </div>
                    <div class="d-flex align-items-baseline justify-content-between my-2">
                        <span class="fw-bold fs-3" style="color: var(--accent-navy); font-family: var(--font-mono); line-height: 1.2;">
                            <span id="dashFleetRunning">@runningCount</span> <span class="text-muted fw-normal fs-6">/ <span id="dashFleetTotal">@Model.Containers.Count</span> active</span>
                        </span>
                        <span class="badge @(runningCount == Model.Containers.Count && Model.Containers.Any() ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-dark border") font-mono" style="font-size: 10px;" id="dashFleetBadge">
                            @(Model.Containers.Any() ? (runningCount == Model.Containers.Count ? "100% Healthy" : $"{runningPct:F0}% Running") : "Idle")
                        </span>
                    </div>
                </div>
                <div>
                    <!-- Segmented Fleet Status Bar -->
                    <div class="w-100 rounded-pill overflow-hidden d-flex mb-1" style="height: 6px; background-color: #e2e8f0;">
                        <div id="dashFleetBarRunning" style="width: @runningPct%; background-color: var(--status-running-dot);" title="Running: @runningCount"></div>
                        <div id="dashFleetBarStopped" style="width: @stoppedPct%; background-color: #94a3b8;" title="Stopped: @stoppedCount"></div>
                        <div id="dashFleetBarPaused" style="width: @pausedPct%; background-color: var(--status-restarting-dot);" title="Paused: @pausedCount"></div>
                    </div>
                    <div class="d-flex justify-content-between font-mono text-muted" style="font-size: 11px;">
                        <span>running: <strong class="text-success" id="dashFleetFooterRunning">@runningCount</strong></span>
                        <span>stopped: <strong class="text-dark" id="dashFleetFooterStopped">@stoppedCount</strong></span>
                        <span>paused: <strong class="text-warning" id="dashFleetFooterPaused">@pausedCount</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Host CPU -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="bg-white border rounded p-3 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-cpu text-secondary fs-6"></i>
                            <span class="text-uppercase fw-semibold text-muted" style="font-size: 11px; letter-spacing: 0.04em;">Host CPU</span>
                        </div>
                        <span class="font-mono text-muted" style="font-size: 11px;">@Model.HostInfo.CpuCores vCPUs</span>
                    </div>
                    <div class="d-flex align-items-baseline justify-content-between my-2">
                        <span class="fw-bold fs-3" style="color: var(--accent-navy); font-family: var(--font-mono); line-height: 1.2;" id="dashTotalCpu">@(initialCpu.ToString("F1"))%</span>
                        <span class="font-mono text-muted text-truncate" style="font-size: 11px; max-width: 140px;" title="@Model.HostInfo.CpuModelName">@Model.HostInfo.CpuModelShort</span>
                    </div>
                </div>
                <div>
                    <!-- Live CPU Progress Bar -->
                    <div class="w-100 rounded-pill overflow-hidden d-flex mb-1" style="height: 6px; background-color: #e2e8f0;">
                        <div id="dashCpuMeterBar" style="width: @(Math.Min(100.0, Math.Max(initialCpu > 0 ? 2.0 : 0.0, initialCpu)))%; background-color: var(--accent-navy);" title="Fleet CPU: @(initialCpu.ToString("F1"))%"></div>
                    </div>
                    <div class="d-flex justify-content-between font-mono text-muted" style="font-size: 11px;">
                        <span>Load: @(Model.HostInfo.LoadAvg1m.ToString("F2"))</span>
                        <span>5m: @(Model.HostInfo.LoadAvg5m.ToString("F2"))</span>
                        <span>Peak: <span id="liveCpuBadge">@(initialCpu.ToString("F1"))%</span></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Host Memory -->
        @{
            var hostTotalMem = Math.Max(1.0, Model.HostInfo.TotalMemoryGb);
            var hostUsedMem = Model.HostInfo.UsedMemoryGb;
            var dockerMemGb = Math.Round(initialMemMb / 1024.0, 2);
            var sysMemGb = Math.Max(0.0, Math.Round(hostUsedMem - dockerMemGb, 2));

            var dockerMemPct = Math.Min(100.0, Math.Round((dockerMemGb / hostTotalMem) * 100.0, 1));
            var sysMemPct = Math.Min(100.0 - dockerMemPct, Math.Round((sysMemGb / hostTotalMem) * 100.0, 1));
            var hostMemPct = Model.HostInfo.MemoryUsagePercentage;
        }
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="bg-white border rounded p-3 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-memory text-secondary fs-6"></i>
                            <span class="text-uppercase fw-semibold text-muted" style="font-size: 11px; letter-spacing: 0.04em;">Host Memory</span>
                        </div>
                        <span class="font-mono text-dark fw-medium" style="font-size: 11px;" id="dashMemPct">@(hostMemPct.ToString("F1"))%</span>
                    </div>
                    <div class="d-flex align-items-baseline justify-content-between my-2">
                        <span class="fw-bold fs-3" style="color: var(--accent-navy); font-family: var(--font-mono); line-height: 1.2;">
                            <span id="dashTotalMemVal">@(hostUsedMem.ToString("F1"))</span> <span class="text-muted fw-normal fs-6">/ @(hostTotalMem.ToString("F1")) GB</span>
                        </span>
                        <span class="font-mono px-2 py-0.5 rounded bg-light text-dark fw-medium text-truncate" style="font-size: 10px; border: 1px solid var(--border-color); max-width: 120px;" title="@Model.HostInfo.OperatingSystem">@Model.HostInfo.MemoryLabel</span>
                    </div>
                </div>
                <div>
                    <!-- Segmented Memory Bar -->
                    <div class="w-100 rounded-pill overflow-hidden d-flex mb-1" style="height: 6px; background-color: #e2e8f0;">
                        <div id="dashMemBarDocker" style="width: @(dockerMemPct > 0 ? Math.Max(1.5, dockerMemPct) : 0)%; background-color: var(--accent-navy);" title="Docker Containers: @(dockerMemGb.ToString("F2")) GB (@dockerMemPct%)"></div>
                        <div id="dashMemBarSystem" style="width: @(sysMemPct > 0 ? sysMemPct : 0)%; background-color: #64748b;" title="Host OS &amp; Buffers: @(sysMemGb.ToString("F1")) GB (@sysMemPct%)"></div>
                    </div>
                    <div class="d-flex justify-content-between font-mono text-muted" style="font-size: 11px;">
                        <span>Docker: <span id="dashMemFooterDocker">@(initialMemMb.ToString("F0"))M</span></span>
                        <span>System: @(sysMemGb.ToString("F1"))G</span>
                        <span>Avail: @(Model.HostInfo.AvailableMemoryGb.ToString("F1"))G</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Docker Root Storage -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="bg-white border rounded p-3 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-hdd text-secondary fs-6"></i>
                            <span class="text-uppercase fw-semibold text-muted" style="font-size: 11px; letter-spacing: 0.04em;">Docker Root</span>
                        </div>
                        <span class="font-mono text-dark fw-medium" style="font-size: 11px;">@(Model.StorageInfo.DiskUsagePercentage.ToString("F1"))%</span>
                    </div>
                    <div class="d-flex align-items-baseline justify-content-between my-2">
                        <span class="fw-bold fs-3" style="color: var(--accent-navy); font-family: var(--font-mono); line-height: 1.2;">
                            @(Model.StorageInfo.UsedDiskGb.ToString("F1")) <span class="text-muted fw-normal fs-6">/ @(Model.StorageInfo.TotalDiskGb.ToString("F0")) GB</span>
                        </span>
                        <span class="font-mono text-muted" style="font-size: 11px;">@Model.StorageInfo.StorageDriver pool</span>
                    </div>
                </div>
                <div>
                    <!-- Segmented Storage Bar -->
                    @{
                        var totalDisk = Math.Max(1.0, Model.StorageInfo.TotalDiskGb);
                        var totalDockerGb = Model.StorageInfo.ImagesSizeGb + Model.StorageInfo.VolumesSizeGb + Model.StorageInfo.ContainersSizeGb;
                        var safeDockerGb = Math.Min(Model.StorageInfo.UsedDiskGb, totalDockerGb);
                        var systemUsedGb = Math.Max(0.0, Model.StorageInfo.UsedDiskGb - safeDockerGb);

                        var dockerPct = Math.Round((safeDockerGb / totalDisk) * 100.0, 1);
                        var sysPct = Math.Min(100.0 - dockerPct, Math.Round((systemUsedGb / totalDisk) * 100.0, 1));
                    }
                    <div class="w-100 rounded-pill overflow-hidden d-flex mb-1" style="height: 6px; background-color: #e2e8f0;">
                        @if (dockerPct > 0)
                        {
                            <div style="width: @(Math.Max(1.5, dockerPct))%; background-color: var(--accent-navy);" title="Docker: @(safeDockerGb.ToString("F1")) GB (@dockerPct%)"></div>
                        }
                        @if (sysPct > 0)
                        {
                            <div style="width: @sysPct%; background-color: #64748b;" title="System &amp; Other: @(systemUsedGb.ToString("F1")) GB (@sysPct%)"></div>
                        }
                    </div>
                    <div class="d-flex justify-content-between font-mono text-muted" style="font-size: 11px;">
                        <span title="Docker allocated data (images, volumes, layers)">Docker: @(safeDockerGb.ToString("F1"))G</span>
                        <span title="Host OS and other software">System: @(systemUsedGb.ToString("F1"))G</span>
                        <span title="Available unallocated disk space">Free: @(Model.StorageInfo.FreeDiskGb.ToString("F1"))G</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Operational Two-Column Layout -->
    <div class="row g-3">
        <!-- Left Column: Priority Workloads & Host Daemon Actions (~60% width) -->
        <div class="col-12 col-xl-7 d-flex flex-column gap-3">
            <!-- Active Focus & Top Consumers Panel -->
            <div class="bg-white border rounded p-3">
                <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                    <div>
                        <h2 class="h6 fw-bold mb-0" style="color: var(--accent-navy); font-size: 14px;">Active Focus &amp; Top Consumers</h2>
                        <span class="text-muted" style="font-size: 11px;">Containers requiring operator intervention or generating peak utilization</span>
                    </div>
                    <span class="text-uppercase fw-semibold font-mono text-muted px-2 py-0.5 rounded bg-light" style="font-size: 10px; border: 1px solid var(--border-color); letter-spacing: 0.04em;">Priority Queue</span>
                </div>

                <!-- Priority Container Workloads List -->
                <div class="d-flex flex-column gap-2" id="dashWorkloadContainerList">
                    @if (!Model.Containers.Any())
                    {
                        <div class="p-4 text-center text-muted font-mono bg-light rounded border">
                            <i class="bi bi-box-seam fs-3 d-block mb-2 text-secondary"></i>
                            <div>No containers currently detected on host daemon.</div>
                            <a href="/Deploy" class="btn btn-sm text-white mt-2 font-mono d-inline-flex align-items-center gap-1" style="background-color: var(--accent-navy); font-size: 11px; padding: 4px 12px;">
                                <i class="bi bi-plus"></i> Deploy Container
                            </a>
                        </div>
                    }
                    else
                    {
                        @foreach (var c in priorityContainers)
                        {
                            var hasMetric = Model.InitialMetrics.TryGetValue(c.Id, out var metric);
                            var cpu = hasMetric ? metric!.CpuPercentage : 0.0;
                            var memMb = hasMetric ? metric!.MemoryUsageMb : 0.0;
                            var memPct = hasMetric ? metric!.MemoryPercentage : 0.0;
                            var isAlerting = c.State != "running";

                            <div class="p-2 rounded border dash-workload-row @(isAlerting ? "workload-alerting" : "") d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2" 
                                 data-container-id="@c.Id" 
                                 data-state="@c.State">
                                <div class="d-flex align-items-start gap-2 min-w-0">
                                    <div class="dash-workload-icon flex-shrink-0 mt-0.5" id="dash-icon-@c.Id">
                                        @if (isAlerting)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-box-seam text-secondary fs-5"></i>
                                        }
                                    </div>
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <a href="/Details?id=@c.Id" class="fw-bold dash-workload-name text-decoration-none text-truncate" style="font-size: 13px;">@c.Name</a>
                                            <span id="dash-pill-@c.Id">
                                                <partial name="_StatusPill" model="c.State" />
                                            </span>
                                            @if (c.Ports.Any())
                                            {
                                                <span class="font-mono text-muted" style="font-size: 11px;">ports: @string.Join(", ", c.Ports.Take(2))</span>
                                            }
                                        </div>
                                        <div class="font-mono text-muted dash-workload-meta mt-1 d-flex align-items-center gap-2 flex-wrap" style="font-size: 11px;">
                                            <span class="dash-meta-label">CPU: <span id="dash-cpu-val-@c.Id">@cpu.ToString("F1")%</span></span>
                                            <span>&bull;</span>
                                            <span class="dash-meta-label">RAM: <span id="dash-mem-val-@c.Id">@memMb.ToString("F1") MB</span></span>
                                            <span>&bull;</span>
                                            <span class="text-truncate">@c.Image</span>
                                        </div>
                                        <!-- Mini Resource Meter Track -->
                                        <div class="mini-meter-track mt-1" style="width: 140px; height: 3px;">
                                            <div class="mini-meter-fill cpu" id="dash-cpu-bar-@c.Id" style="width: @(Math.Min(100, Math.Max(2, cpu)))%;"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1 flex-shrink-0 align-self-end align-self-md-center">
                                    <a href="/Details?id=@c.Id" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1 font-mono" style="font-size: 11px; padding: 3px 8px;">
                                        <i class="bi bi-terminal"></i> Inspect Logs
                                    </a>
                                    <div class="row-actions" id="dash-actions-@c.Id">
                                        @if (c.State != "running")
                                        {
                                            <button class="btn-icon-action action-start" onclick="executeDashboardAction('@c.Id', 'start', this)" title="Start">
                                                <i class="bi bi-play-fill"></i>
                                            </button>
                                        }
                                        @if (c.State == "running")
                                        {
                                            <button class="btn-icon-action action-stop" onclick="executeDashboardAction('@c.Id', 'stop', this)" title="Stop">
                                                <i class="bi bi-stop-fill"></i>
                                            </button>
                                            <button class="btn-icon-action action-restart" onclick="executeDashboardAction('@c.Id', 'restart', this)" title="Restart">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        }
                                        @if (c.State == "paused")
                                        {
                                            <button class="btn-icon-action action-start" onclick="executeDashboardAction('@c.Id', 'unpause', this)" title="Resume">
                                                <i class="bi bi-play-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    @if (!priorityContainers.Any())
                    {
                        <div class="p-3 text-center font-mono text-muted" style="font-size: 12px;">
                            @if (!Model.IsConnectedToDocker)
                            {
                                <span class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle me-1"></i> Daemon offline.</span>
                                <span class="ms-1">Unable to query workloads from @Model.DaemonEndpoint.</span>
                            }
                            else
                            {
                                <span>No active containers found. <a href="/Deploy" class="text-decoration-none">Deploy a container</a> to get started.</span>
                            }
                        </div>
                    }
                </div>


                <!-- Footnote Navigation link -->
                <div class="pt-3 mt-2 border-top d-flex align-items-center justify-content-between">
                    <span class="font-mono text-muted" style="font-size: 11px;">Showing top @priorityContainers.Count prioritized workloads</span>
                    <a href="/Containers" class="text-decoration-none fw-semibold d-inline-flex align-items-center gap-1 dash-fleet-link" style="font-size: 12px;">
                        <span>View all @Model.Containers.Count containers in fleet</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- Quick Operational Action Bar (Host Daemon Actions) -->
            <div class="bg-white border rounded p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h3 class="h6 fw-bold mb-0" style="color: var(--accent-navy); font-size: 13px;">Host Daemon Actions</h3>
                    <span class="font-mono text-muted" style="font-size: 11px;">docker.sock unix socket</span>
                </div>
                <div class="row g-2">
                    <div class="col-12 col-sm-4">
                        <button class="btn btn-light border text-start w-100 p-2 d-flex flex-column gap-1 h-100" style="background-color: #f8fafc;" onclick="window.showToast('Triggered image prune check')">
                            <div class="d-flex align-items-center justify-content-between w-100">
                                <i class="bi bi-trash3 text-primary fs-6"></i>
                                <span class="font-mono text-muted fw-semibold" style="font-size: 10px;">1.2 GB rec.</span>
                            </div>
                            <div class="fw-bold text-dark mt-1" style="font-size: 12px;">Prune Unused Images</div>
                            <div class="font-mono text-muted" style="font-size: 10px;">Dangling layers &amp; build cache</div>
                        </button>
                    </div>
                    <div class="col-12 col-sm-4">
                        <button class="btn btn-light border text-start w-100 p-2 d-flex flex-column gap-1 h-100" style="background-color: #f8fafc;" onclick="window.showToast('Daemon health verified')">
                            <div class="d-flex align-items-center justify-content-between w-100">
                                <i class="bi bi-arrow-repeat text-primary fs-6"></i>
                                <span class="font-mono text-secondary fw-semibold" style="font-size: 10px;">Clean Exit</span>
                            </div>
                            <div class="fw-bold text-dark mt-1" style="font-size: 12px;">Restart Docker Daemon</div>
                            <div class="font-mono text-muted" style="font-size: 10px;">systemctl restart docker</div>
                        </button>
                    </div>
                    <div class="col-12 col-sm-4">
                        <a href="/Deploy" class="btn btn-light border text-start w-100 p-2 d-flex flex-column gap-1 h-100 text-decoration-none" style="background-color: #f8fafc;">
                            <div class="d-flex align-items-center justify-content-between w-100">
                                <i class="bi bi-rocket-takeoff text-primary fs-6"></i>
                                <span class="font-mono text-muted fw-semibold" style="font-size: 10px;">Deploy</span>
                            </div>
                            <div class="fw-bold text-dark mt-1" style="font-size: 12px;">Deploy Container</div>
                            <div class="font-mono text-muted" style="font-size: 10px;">Pull image &amp; launch instance</div>
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- Right Column: Daemon Event Stream & Storage Pool Diagnostics (~40% width) -->
        <div class="col-12 col-xl-5 d-flex flex-column gap-3">
            <!-- Event Stream Log Panel -->
            <div class="bg-white border rounded d-flex flex-column">
                <div class="p-3 pb-2 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="rounded-circle d-inline-block" style="width: 7px; height: 7px; background-color: var(--status-running-dot);"></span>
                        <h3 class="h6 fw-bold mb-0" style="color: var(--accent-navy); font-size: 13px;">Daemon Event Stream</h3>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="font-mono px-2 py-0.5 rounded bg-light text-muted fw-semibold" style="font-size: 10px; border: 1px solid var(--border-color);">LIVE</span>
                        <button class="btn-icon-action" title="Clear buffer" style="width: 22px; height: 22px;" onclick="document.getElementById('clusterEventFeed').innerHTML='';">
                            <i class="bi bi-text-left" style="font-size: 12px;"></i>
                        </button>
                    </div>
                </div>

                <!-- Monospace Console Feed -->
                <div class="px-3 pb-3">
                    <div class="p-2 rounded font-mono cli-terminal-window" id="clusterEventFeed" style="font-size: 11px; line-height: 1.5; max-height: 310px; overflow-y: auto;">
                        <!-- Initial live events from active container fleet -->
                        @if (Model.Containers.Any())
                        {
                            @foreach (var c in Model.Containers.Take(4))
                            {
                                <div class="event-feed-item py-1 border-bottom d-flex align-items-start gap-2" style="border-color: rgba(255,255,255,0.06) !important;">
                                    <span class="event-time text-secondary flex-shrink-0" style="color: #64748b !important;">[@DateTime.UtcNow.ToString("HH:mm:ss")]</span>
                                    <div>
                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                            <span class="@(c.State == "running" ? "text-success" : (c.State == "paused" ? "text-warning" : "text-danger")) fw-bold">@c.State</span>
                                            <span style="color: var(--accent-ice);">@c.Name</span>
                                            <span class="text-muted">(@c.Status)</span>
                                        </div>
                                        <div class="text-muted" style="font-size: 10px;">image: @c.Image &bull; id: @c.ShortId</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="event-feed-item py-1 d-flex align-items-start gap-2">
                                <span class="event-time text-secondary flex-shrink-0" style="color: #64748b !important;">[@DateTime.UtcNow.ToString("HH:mm:ss")]</span>
                                <div class="text-muted">Telemetry monitor initialized. Awaiting container lifecycle events...</div>
                            </div>
                        }
                    </div>
                </div>


                <div class="px-3 py-2 bg-light border-top rounded-bottom d-flex align-items-center justify-content-between font-mono text-muted" style="font-size: 11px;">
                    <span>Filtering: <span class="text-dark fw-medium" id="eventFeedCount">All events (4)</span></span>
                    <button class="btn btn-link p-0 text-decoration-none fw-semibold dash-buffer-export-btn" style="font-size: 11px;" onclick="window.showToast('Buffer exported to clipboard')">Export Buffer</button>
                </div>
            </div>

            <!-- Storage Pool Diagnostics Breakdown -->
            @{
                var totalDockerAllocated = Model.StorageInfo.ImagesSizeGb + Model.StorageInfo.VolumesSizeGb + Model.StorageInfo.ContainersSizeGb;
                var poolDenominator = Math.Max(0.1, totalDockerAllocated);
                var volPoolPct = Math.Round((Model.StorageInfo.VolumesSizeGb / poolDenominator) * 100.0, 1);
                var imgPoolPct = Math.Round((Model.StorageInfo.ImagesSizeGb / poolDenominator) * 100.0, 1);
                var cntPoolPct = Math.Round((Model.StorageInfo.ContainersSizeGb / poolDenominator) * 100.0, 1);
            }
            <div class="bg-white border rounded p-3 d-flex flex-column gap-2">
                <div class="d-flex align-items-center justify-content-between">
                    <h3 class="h6 fw-bold mb-0" style="color: var(--accent-navy); font-size: 13px;">Storage Pool Diagnostics</h3>
                    <span class="font-mono text-muted" style="font-size: 11px;">@Model.StorageInfo.FileSystemName (@Model.StorageInfo.StorageDriver)</span>
                </div>

                <div class="d-flex flex-column gap-2 my-1">
                    <div>
                        <div class="d-flex justify-content-between font-mono text-muted mb-1" style="font-size: 11px;">
                            <span>Container Volumes</span>
                            <span class="fw-semibold text-dark">@(Model.StorageInfo.VolumesSizeGb.ToString("F1")) GB</span>
                        </div>
                        <div class="w-100 rounded-pill overflow-hidden" style="height: 6px; background-color: #e2e8f0;">
                            <div style="width: @(Model.StorageInfo.VolumesSizeGb > 0 ? Math.Min(100.0, Math.Max(2.0, volPoolPct)) : 0)%; height: 100%; background-color: var(--accent-navy);" title="Volumes: @(Model.StorageInfo.VolumesSizeGb.ToString("F1")) GB (@volPoolPct%)"></div>
                        </div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between font-mono text-muted mb-1" style="font-size: 11px;">
                            <span>Docker Overlay2 Images</span>
                            <span class="fw-semibold text-dark">@(Model.StorageInfo.ImagesSizeGb.ToString("F1")) GB</span>
                        </div>
                        <div class="w-100 rounded-pill overflow-hidden" style="height: 6px; background-color: #e2e8f0;">
                            <div style="width: @(Model.StorageInfo.ImagesSizeGb > 0 ? Math.Min(100.0, Math.Max(2.0, imgPoolPct)) : 0)%; height: 100%; background-color: var(--accent-navy);" title="Images: @(Model.StorageInfo.ImagesSizeGb.ToString("F1")) GB (@imgPoolPct%)"></div>
                        </div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between font-mono text-muted mb-1" style="font-size: 11px;">
                            <span>Writable Container Layers</span>
                            <span class="fw-semibold text-dark">@(Model.StorageInfo.ContainersSizeGb.ToString("F2")) GB</span>
                        </div>
                        <div class="w-100 rounded-pill overflow-hidden" style="height: 6px; background-color: #e2e8f0;">
                            <div style="width: @(Model.StorageInfo.ContainersSizeGb > 0 ? Math.Min(100.0, Math.Max(2.0, cntPoolPct)) : 0)%; height: 100%; background-color: #64748b;" title="Layers: @(Model.StorageInfo.ContainersSizeGb.ToString("F2")) GB (@cntPoolPct%)"></div>
                        </div>
                    </div>
                </div>

                <div class="pt-2 border-top d-flex align-items-center justify-content-between font-mono text-muted" style="font-size: 11px;">
                    <span>Total Docker Allocated: @(totalDockerAllocated.ToString("F1")) GB</span>
                    <span class="@(Model.StorageInfo.DiskUsagePercentage > 90 ? "text-danger" : "text-success") fw-bold">@(Model.StorageInfo.DiskUsagePercentage > 90 ? "Low Disk Space" : "Healthy")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
