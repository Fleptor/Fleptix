@page
@model Fleptix.Observer.Pages.DetailsModel
@{
    ViewData["Title"] = $"{Model.Details?.Summary.Name ?? "Container"} - Details";
    var c = Model.Details!.Summary;
    var d = Model.Details!;
    var m = Model.InitialMetrics;

    var cpu = m != null ? m.CpuPercentage : 18.2;
    var memMb = m != null ? m.MemoryUsageMb : 1980.0;
    var memLimitMb = m != null && m.MemoryLimitMb > 0 ? m.MemoryLimitMb : 2048.0;
    var memPct = m != null && m.MemoryPercentage > 0 ? m.MemoryPercentage : 96.7;

    string stackName = "standalone";
    var n = c.Name.ToLowerInvariant();
    if (n.Contains("traefik") || n.Contains("pgsql") || n.Contains("postgres") || n.Contains("redis") || n.Contains("authentik") || n.Contains("infra"))
        stackName = "core-infra";
    else if (n.Contains("immich") || n.Contains("media") || n.Contains("nextcloud") || n.Contains("homarr"))
        stackName = "media-suite";
    else if (n.Contains("grafana") || n.Contains("prom") || n.Contains("mon"))
        stackName = "observability";
}

<div class="container-fluid p-0">
    <!-- Top Operational Breadcrumb & Context Header -->
    <div class="d-flex flex-column gap-2 mb-3">
        <div class="d-flex align-items-center justify-content-between font-mono text-muted" style="font-size: 11px;">
            <div class="d-flex align-items-center gap-1.5">
                <a href="/Containers" class="text-decoration-none fw-semibold d-flex align-items-center gap-1" style="color: var(--accent-navy);">
                    <i class="bi bi-arrow-left"></i>
                    <span>Containers</span>
                </a>
                <span>/</span>
                <span class="px-1.5 py-0.5 rounded bg-light border text-dark">@stackName</span>
                <span>/</span>
                <span class="fw-bold text-dark">@c.Name</span>
                <span class="text-muted">(@c.ShortId)</span>
            </div>
            <!-- Heartbeat / Failure Indicators -->
            <div class="d-flex align-items-center gap-2">
                @if (c.State != "running")
                {
                    <span class="d-flex align-items-center gap-1 px-2 py-0.5 rounded" style="background-color: #fee2e2; color: #dc2626;">
                        <span class="rounded-circle d-inline-block" style="width: 6px; height: 6px; background-color: #dc2626;"></span>
                        <span>State Alert: @c.State</span>
                    </span>
                }
                <span class="px-2 py-0.5 rounded bg-light border text-dark">Engine: Live</span>
            </div>
        </div>

        <!-- Main Container Banner Card -->
        <div class="bg-white p-3 rounded border shadow-xs d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="d-flex flex-column gap-1">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <i class="bi bi-box-seam fs-4" style="color: var(--accent-navy);"></i>
                    <h1 class="h5 fw-bold mb-0 text-dark">@c.Name</h1>
                    <span id="detailsStatusPill">
                        <partial name="_StatusPill" model="c.State" />
                    </span>
                    <span class="font-mono text-muted px-2 py-0.5 rounded bg-light border" style="font-size: 11px;">
                        Stack: @stackName
                    </span>
                </div>
                <!-- Metadata Strip -->
                <div class="d-flex flex-wrap align-items-center gap-2 font-mono text-muted mt-1" style="font-size: 11px;">
                    <div><span class="text-secondary">Image:</span> <span class="text-dark fw-medium">@c.Image</span></div>
                    <span>&bull;</span>
                    <div><span class="text-secondary">IP:</span> <span class="text-dark">@(string.IsNullOrEmpty(d.IPAddress) ? "172.20.0.5" : d.IPAddress)</span></div>
                    <span>&bull;</span>
                    <div><span class="text-secondary">Policy:</span> <span class="text-dark">@d.RestartPolicy</span></div>
                    <span>&bull;</span>
                    <div><span class="text-secondary">Status:</span> <span class="text-dark" id="detailsStatusText">@c.Status</span></div>
                </div>
            </div>

            <!-- Quick Action Operations Bar -->
            <div class="row-actions d-flex flex-wrap align-items-center gap-1" id="detailsActionGroup">
                <div id="lifecycleActionButtons" class="d-inline-flex align-items-center gap-1">
                    @if (c.State != "running")
                    {
                        <button class="btn btn-sm d-inline-flex align-items-center gap-1 text-white" style="background-color: var(--accent-navy); font-size: 11px; padding: 4px 12px;" onclick="executeDetailsAction('@c.Id', 'start', this)">
                            <i class="bi bi-play-fill"></i> Start
                        </button>
                    }
                    @if (c.State == "running")
                    {
                        <button class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1 font-mono text-danger" style="font-size: 11px; padding: 4px 10px;" onclick="executeDetailsAction('@c.Id', 'stop', this)">
                            <i class="bi bi-stop-fill"></i> Stop
                        </button>
                        <button class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1 font-mono text-dark" style="font-size: 11px; padding: 4px 10px;" onclick="executeDetailsAction('@c.Id', 'restart', this)">
                            <i class="bi bi-arrow-clockwise"></i> Restart
                        </button>
                    }
                    @if (c.State == "paused")
                    {
                        <button class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1 font-mono text-success" style="font-size: 11px; padding: 4px 10px;" onclick="executeDetailsAction('@c.Id', 'unpause', this)">
                            <i class="bi bi-play-fill"></i> Resume
                        </button>
                    }
                </div>
                @if (Model.IsTimeMachineEnabled)
                {
                    <form method="post" asp-page-handler="Snapshot" asp-route-id="@c.Id" class="d-inline" id="snapshotForm">
                        @Html.AntiForgeryToken()
                        <button type="submit" id="btnSnapshot" class="btn btn-sm d-inline-flex align-items-center gap-1 font-mono text-white" style="background-color: var(--accent-navy); font-size: 11px; padding: 4px 10px;" onclick="handleSnapshotClick(event, '@c.Id')">
                            <i class="bi bi-clock-history text-warning"></i>
                            <span id="snapshotBtnText">Snapshot</span>
                            <span class="badge font-mono ms-0.5" style="background-color: #fef3c7; color: #b45309; font-size: 8px; padding: 1px 3px; border: 1px solid #fde68a;">PRO</span>
                            <span id="snapshotSpinner" class="spinner-border spinner-border-sm d-none" style="width: 10px; height: 10px;" role="status"></span>
                        </button>
                    </form>
                }
                else
                {
                    <button type="button" id="btnSnapshot" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1 font-mono text-muted" style="font-size: 11px; padding: 4px 10px; cursor: not-allowed; opacity: 0.85;" title="Time Machine snapshots require a Fleptix Pro license" onclick="window.showToast('Time Machine is locked. Enable a Fleptix Pro license to capture snapshots.', true)">
                        <i class="bi bi-lock-fill" style="color: #d97706;"></i>
                        <span id="snapshotBtnText">Snapshot</span>
                        <span class="badge font-mono ms-0.5" style="background-color: #fef3c7; color: #b45309; font-size: 8px; padding: 1px 3px; border: 1px solid #fde68a;">PRO</span>
                    </button>
                }

                <button class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1 font-mono text-dark" style="font-size: 11px; padding: 4px 10px;" onclick="window.showToast('Triggered kill signal')">
                    <i class="bi bi-x-octagon text-danger"></i> Kill
                </button>
            </div>
        </div>
    </div>

    @if (TempData["SnapshotSuccess"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-2 mb-3 font-mono shadow-xs" style="font-size: 12px;">
            <i class="bi bi-check-circle-fill text-success fs-6"></i>
            <span>@TempData["SnapshotSuccess"]</span>
        </div>
    }
    @if (TempData["SnapshotError"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 p-2 mb-3 font-mono shadow-xs" style="font-size: 12px;">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-6"></i>
            <span>@TempData["SnapshotError"]</span>
        </div>
    }
    @if (TempData["RestoreSuccess"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-2 mb-3 font-mono shadow-xs" style="font-size: 12px;">
            <i class="bi bi-check-circle-fill text-success fs-6"></i>
            <span>@TempData["RestoreSuccess"]</span>
        </div>
    }
    @if (TempData["RestoreError"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 p-2 mb-3 font-mono shadow-xs" style="font-size: 12px;">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-6"></i>
            <span>@TempData["RestoreError"]</span>
        </div>
    }

    <!-- Primary Tabbed Inspection Navigation -->
    <div class="d-flex align-items-center justify-content-between bg-light p-1 rounded border mb-3">
        <div class="d-flex align-items-center gap-1 overflow-x-auto">
            <button class="btn btn-sm btn-light border text-decoration-none details-tab-link active font-mono fw-semibold" data-tab="tabOverview" style="font-size: 11px;">
                <i class="bi bi-speedometer2 me-1"></i> Stats
            </button>
            <button class="btn btn-sm btn-link text-decoration-none text-dark details-tab-link font-mono" data-tab="tabLogs" style="font-size: 11px;">
                <i class="bi bi-terminal me-1"></i> Live Logs <span class="badge bg-danger ms-1">@Model.InitialLogs.Count</span>
            </button>
            <button class="btn btn-sm btn-link text-decoration-none text-dark details-tab-link font-mono" data-tab="tabExec" style="font-size: 11px;">
                <i class="bi bi-terminal-dash me-1"></i> Exec
            </button>
            <button class="btn btn-sm btn-link text-decoration-none text-dark details-tab-link font-mono" data-tab="tabEnv" style="font-size: 11px;">
                <i class="bi bi-key me-1"></i> Environment &amp; Config (@d.EnvironmentVariables.Count)
            </button>
            <button class="btn btn-sm btn-link text-decoration-none text-dark details-tab-link font-mono" data-tab="tabPorts" style="font-size: 11px;">
                <i class="bi bi-diagram-3 me-1"></i> Ports &amp; Networking
            </button>
            <button class="btn btn-sm btn-link text-decoration-none text-dark details-tab-link font-mono" data-tab="tabMounts" style="font-size: 11px;">
                <i class="bi bi-hdd me-1"></i> Volumes &amp; Mounts (@d.Mounts.Count)
            </button>
            <button class="btn btn-sm btn-link text-decoration-none text-dark details-tab-link font-mono" data-tab="tabFiles" style="font-size: 11px;">
                <i class="bi bi-folder2 me-1"></i> Files
            </button>
            <button class="btn btn-sm btn-link text-decoration-none text-dark details-tab-link font-mono d-inline-flex align-items-center gap-1" data-tab="tabSnapshots" style="font-size: 11px;">
                @if (Model.IsTimeMachineEnabled)
                {
                    <i class="bi bi-clock-history text-warning"></i>
                    <span>Time Machine</span>
                    <span class="text-muted">(<span id="snapshotCountBadge">@Model.Snapshots.Count</span>)</span>
                    <span class="badge font-mono ms-0.5" style="background-color: #fef3c7; color: #b45309; font-size: 8px; padding: 1px 3px; border: 1px solid #fde68a;">PRO</span>
                }
                else
                {
                    <i class="bi bi-lock-fill" style="color: #d97706;"></i>
                    <span>Time Machine</span>
                    <span class="badge font-mono ms-0.5" style="background-color: #fef3c7; color: #b45309; font-size: 8px; padding: 1px 3px; border: 1px solid #fde68a;">PRO</span>
                }
            </button>
        </div>
        <div class="font-mono text-muted pe-2 d-none d-md-block" style="font-size: 10px;">
            <i class="bi bi-arrow-repeat me-1"></i> Live refresh: 1s
        </div>
    </div>


    <!-- TAB 1: STATS -->
    <div id="tabOverview" class="tab-pane-content">
        <div class="d-flex flex-column gap-3">
            <!-- 4-Tile Telemetry Grid -->
            <div class="row g-2">
                <!-- Tile 1: CPU -->
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="bg-white border rounded p-3 h-100 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between text-muted font-mono" style="font-size: 10px;">
                            <span class="text-uppercase fw-semibold">CPU Usage</span>
                            <i class="bi bi-speedometer2"></i>
                        </div>
                        <div class="d-flex align-items-baseline gap-1 my-1">
                            <span class="font-mono fw-bold fs-4" style="color: var(--accent-navy);" id="detailsCpuVal">@cpu.ToString("F1")%</span>
                            <span class="font-mono text-muted" style="font-size: 10px;">/ 4 Cores</span>
                        </div>
                        <div>
                            <div class="w-100 mb-1" style="height: 20px;">
                                <svg class="w-100 h-100" viewBox="0 0 100 24" preserveAspectRatio="none">
                                    <path d="M0,20 L10,18 L20,19 L30,12 L40,14 L50,8 L60,11 L70,6 L80,14 L90,12 L100,5" fill="none" stroke="#1E2761" stroke-width="1.8" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
                                </svg>
                            </div>
                            <div class="d-flex justify-content-between font-mono text-muted" style="font-size: 9px;">
                                <span>Throttled: 0.0s</span>
                                <span>Load: 0.72</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tile 2: Memory -->
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="bg-white border rounded p-3 h-100 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between text-muted font-mono" style="font-size: 10px;">
                            <span class="text-uppercase fw-semibold">Memory</span>
                            <i class="bi bi-memory"></i>
                        </div>
                        <div class="d-flex align-items-baseline gap-1 my-1">
                            <span class="font-mono fw-bold fs-4 text-dark" id="detailsMemVal">@memMb.ToString("F0") MB</span>
                            <span class="font-mono text-muted" style="font-size: 10px;">/ @memLimitMb.ToString("F0") MB</span>
                        </div>
                        <div>
                            <div class="mini-meter-track mb-1" style="height: 4px;">
                                <div class="mini-meter-fill mem" id="detailsMemBar" style="width: @(Math.Min(100, Math.Max(5, memPct)))%;"></div>
                            </div>
                            <div class="d-flex justify-content-between font-mono text-muted" style="font-size: 9px;">
                                <span>Swap: 512 MB</span>
                                <span>@memPct.ToString("F1")% Limit</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tile 3: Network I/O -->
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="bg-white border rounded p-3 h-100 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between text-muted font-mono" style="font-size: 10px;">
                            <span class="text-uppercase fw-semibold">Network I/O</span>
                            <i class="bi bi-arrow-down-up"></i>
                        </div>
                        <div class="font-mono my-1" style="font-size: 11px;">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">RX:</span> <span class="fw-bold text-dark">14.2 MB/s</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">TX:</span> <span class="fw-bold text-secondary">2.8 MB/s</span>
                            </div>
                        </div>
                        <div class="border-top pt-1 font-mono text-muted d-flex justify-content-between" style="font-size: 9px;">
                            <span>Total: 42.1 GB</span>
                            <span>Drops: 0</span>
                        </div>
                    </div>
                </div>

                <!-- Tile 4: Block / Disk I/O -->
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="bg-white border rounded p-3 h-100 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between text-muted font-mono" style="font-size: 10px;">
                            <span class="text-uppercase fw-semibold">Block / Disk I/O</span>
                            <i class="bi bi-hdd"></i>
                        </div>
                        <div class="font-mono my-1" style="font-size: 11px;">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Read:</span> <span class="fw-bold text-dark">120.4 MB</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Write:</span> <span class="fw-bold text-secondary">450.8 MB</span>
                            </div>
                        </div>
                        <div class="border-top pt-1 font-mono text-muted d-flex justify-content-between" style="font-size: 9px;">
                            <span>IOPS: 142 op/s</span>
                            <span>NVMe Pool</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Security & Execution Profile -->
            <div class="bg-white border rounded p-3 shadow-xs d-flex flex-column gap-2">
                <div class="d-flex align-items-center gap-1.5 font-mono fw-semibold text-dark" style="font-size: 12px;">
                    <i class="bi bi-shield-check text-success"></i>
                    <span>Security &amp; Execution Profile</span>
                </div>
                <div class="row g-2 font-mono text-muted" style="font-size: 10px;">
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded bg-light border">
                            <span class="text-muted d-block">Privileged:</span>
                            <span class="fw-bold text-dark">false</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded bg-light border">
                            <span class="text-muted d-block">User (UID:GID):</span>
                            <span class="fw-bold text-dark">1000:1000</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded bg-light border">
                            <span class="text-muted d-block">Readonly Root:</span>
                            <span class="fw-bold text-dark">false</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded bg-light border">
                            <span class="text-muted d-block">AppArmor:</span>
                            <span class="fw-bold text-dark">docker-default</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 2: LIVE LOGS FULL -->
    <div id="tabLogs" class="tab-pane-content d-none">
        <div class="bg-white border rounded p-3 mb-2 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold font-mono">Stream: stdout / stderr</span>
                <span class="badge bg-secondary font-mono">@Model.InitialLogs.Count entries</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" onclick="fetchLatestLogs()">
                    <i class="bi bi-arrow-repeat"></i> Refresh
                </button>
            </div>
        </div>
        <div id="terminalLogBody" class="dense-terminal" style="height: 480px;">
            @foreach (var line in Model.InitialLogs)
            {
                var l = line.ToLowerInvariant();
                var lineClass = l.Contains("error") || l.Contains("fail") ? "log-line error" : (l.Contains("warn") ? "log-line warn" : "log-line info");
                <div class="@lineClass">@line</div>
            }
        </div>
    </div>

    <!-- TAB: EXEC / INTERACTIVE SHELL -->
    <div id="tabExec" class="tab-pane-content d-none">
        <div class="bg-white border rounded overflow-hidden">
            <!-- Compact Configuration Bar: Shell, Workdir, User (Visually secondary single row) -->
            <div class="d-flex align-items-center justify-content-between px-2.5 py-1 border-bottom font-mono exec-config-bar overflow-x-auto" style="font-size: 10px; min-height: 28px;">
                <!-- Left: Execution Configuration Options -->
                <div class="d-flex align-items-center gap-2.5 text-muted flex-shrink-0">
                    <div class="d-flex align-items-center gap-1">
                        <span style="font-size: 10px; color: #64748b;">shell:</span>
                        <select id="execShellSelect" class="form-select form-select-sm font-mono py-0 ps-1.5 pe-4 bg-white border text-secondary" style="font-size: 10px; height: 22px; width: 90px; border-color: #cbd5e1 !important;">
                            <option value="/bin/sh" selected>/bin/sh</option>
                            <option value="/bin/bash">/bin/bash</option>
                            <option value="/bin/ash">/bin/ash</option>
                            <option value="direct">direct</option>
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-1">
                        <span style="font-size: 10px; color: #64748b;">workdir:</span>
                        <input type="text" id="execWorkDirInput" class="form-control form-control-sm font-mono py-0 px-1.5 bg-white border text-secondary" placeholder="/" value="/" style="font-size: 10px; height: 22px; width: 80px; border-color: #cbd5e1 !important;">
                    </div>

                    <div class="d-flex align-items-center gap-1">
                        <span style="font-size: 10px; color: #64748b;">user:</span>
                        <input type="text" id="execUserInput" class="form-control form-control-sm font-mono py-0 px-1.5 bg-white border text-secondary" placeholder="root" value="root" style="font-size: 10px; height: 22px; width: 65px; border-color: #cbd5e1 !important;">
                    </div>
                </div>

                <!-- Right: Utilities (Auto-scroll, Copy, Clear) -->
                <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-2">
                    <div class="form-check form-switch mb-0 d-flex align-items-center gap-1" style="font-size: 10px;">
                        <input class="form-check-input" type="checkbox" role="switch" id="execAutoScrollSwitch" checked style="cursor: pointer; width: 22px; height: 12px; margin-top: 0;">
                        <label class="form-check-label text-muted" for="execAutoScrollSwitch" style="font-size: 10px;">auto-scroll</label>
                    </div>
                    <span class="text-muted" style="opacity: 0.35;">|</span>
                    <button type="button" class="btn btn-xs bg-white border py-0 px-1.5 font-mono text-secondary d-inline-flex align-items-center gap-1" style="font-size: 10px; height: 22px; border-color: #cbd5e1 !important;" onclick="copyExecTerminalOutput()" title="Copy entire terminal output">
                        <i class="bi bi-clipboard" style="font-size: 9px;"></i> Copy
                    </button>
                    <button type="button" class="btn btn-xs bg-white border py-0 px-1.5 font-mono text-secondary d-inline-flex align-items-center gap-1" style="font-size: 10px; height: 22px; border-color: #cbd5e1 !important;" onclick="clearExecTerminal()" title="Clear terminal screen">
                        <i class="bi bi-trash3" style="font-size: 9px;"></i> Clear
                    </button>
                </div>
            </div>

            <!-- Presets Toolbar: Cohesive, unified toolbar -->
            <div class="d-flex flex-wrap align-items-center gap-1 px-2.5 py-1 border-bottom font-mono" style="font-size: 10px; background-color: #f1f5f9;">
                <span class="text-muted me-1 fw-semibold" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em;">Presets:</span>
                <button type="button" class="btn btn-xs exec-preset-btn font-mono" onclick="insertExecPreset('uname -a')">uname -a</button>
                <button type="button" class="btn btn-xs exec-preset-btn font-mono" onclick="insertExecPreset('whoami')">whoami</button>
                <button type="button" class="btn btn-xs exec-preset-btn font-mono" onclick="insertExecPreset('ps aux')">ps aux</button>
                <button type="button" class="btn btn-xs exec-preset-btn font-mono" onclick="insertExecPreset('df -h')">df -h</button>
                <button type="button" class="btn btn-xs exec-preset-btn font-mono" onclick="insertExecPreset('free -m')">free -m</button>
                <button type="button" class="btn btn-xs exec-preset-btn font-mono" onclick="insertExecPreset('env')">env</button>
                <button type="button" class="btn btn-xs exec-preset-btn font-mono" onclick="insertExecPreset('ls -la')">ls -la</button>
                <button type="button" class="btn btn-xs exec-preset-btn font-mono" onclick="insertExecPreset('cat /etc/os-release')">os-release</button>
            </div>

            <!-- State Warning if Container is Not Running (Neutral, non-amber) -->
            <div id="execStateAlert" class="@(c.State == "running" ? "d-none" : "") p-2 border-bottom d-flex align-items-center justify-content-between font-mono" style="font-size: 11px; background-color: #f8fafc; color: #475569;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle text-secondary"></i>
                    <span>Container is currently <strong id="execContainerStateText" class="text-dark">@c.State</strong>. Execution requires the container to be running.</span>
                </div>
                <button type="button" class="btn btn-sm font-mono text-white py-0 px-2" style="font-size: 11px; height: 24px; background-color: var(--accent-navy);" onclick="executeDetailsAction('@c.Id', 'start', this)">
                    <i class="bi bi-play-fill"></i> Start Container
                </button>
            </div>

            <!-- Interactive Terminal Console Viewport (Compact idle state) -->
            <div id="execTerminalViewport" class="exec-terminal-idle">
                <div class="text-muted font-mono mb-2 pb-1.5 border-bottom border-secondary border-opacity-20 d-flex align-items-center justify-content-between" style="font-size: 10px; color: #64748b !important;">
                    <div>
                        <span>target: <strong style="color: #cbd5e1;">@c.Name</strong> (@c.ShortId)</span>
                        <span class="mx-1.5 opacity-50">&bull;</span>
                        <span>image: <strong style="color: #cbd5e1;">@c.Image</strong></span>
                    </div>
                    <div class="d-none d-md-block opacity-75">
                        <kbd class="bg-dark text-muted px-1 border border-secondary border-opacity-25" style="font-size: 9px;">Enter</kbd> run &bull; <kbd class="bg-dark text-muted px-1 border border-secondary border-opacity-25" style="font-size: 9px;">&uarr;</kbd> <kbd class="bg-dark text-muted px-1 border border-secondary border-opacity-25" style="font-size: 9px;">&darr;</kbd> history
                    </div>
                </div>
                <div id="execTerminalEntries">
                    <div class="font-mono" id="execTerminalPlaceholder" style="font-size: 11px; color: #64748b; font-style: italic;">
                        Terminal session ready. Select a preset above or type a command below.
                    </div>
                </div>
            </div>

            <!-- Command Input Bar: Navy/neutral accent & Highlighted Input Field -->
            <div class="p-2 border-top exec-input-bar">
                <form id="execCommandForm" onsubmit="handleExecSubmit(event)" class="d-flex align-items-center gap-2 m-0">
                    <div class="exec-input-group d-flex align-items-center flex-grow-1" onclick="document.getElementById('execCommandInput')?.focus()">
                        <span class="exec-prompt-prefix font-mono" id="execPromptPrefix">
                            root@@@(c.ShortId):/#
                        </span>
                        <input type="text" id="execCommandInput" class="exec-command-input font-mono" placeholder="Enter shell command (e.g. ls -la, ps aux, env, whoami)..." autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
                    </div>
                    <button type="submit" id="btnExecRun" class="btn exec-run-btn font-mono d-inline-flex align-items-center gap-1 px-3">
                        <i class="bi bi-play-fill" id="execRunIcon"></i>
                        <span id="execRunBtnText">Run</span>
                        <span id="execRunSpinner" class="spinner-border spinner-border-sm d-none" style="width: 10px; height: 10px;" role="status"></span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- TAB 3: ENVIRONMENT -->
    <div id="tabEnv" class="tab-pane-content d-none">
        <div class="fleptix-table-container">
            <table class="fleptix-table">
                <thead>
                    <tr>
                        <th style="width: 35%;">Variable</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var env in d.EnvironmentVariables)
                    {
                        <tr>
                            <td class="font-mono fw-bold text-dark">@env.Key</td>
                            <td class="font-mono text-muted">@env.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB 4: PORTS -->
    <div id="tabPorts" class="tab-pane-content d-none">
        <div class="fleptix-table-container">
            <table class="fleptix-table">
                <thead>
                    <tr>
                        <th>Container Port</th>
                        <th>Host Binding</th>
                    </tr>
                </thead>
                <tbody>
                    @if (c.Ports.Any())
                    {
                        @foreach (var port in c.Ports)
                        {
                            <tr>
                                <td class="font-mono fw-bold text-dark">@port</td>
                                <td class="font-mono text-muted">0.0.0.0:@port</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-muted font-mono">No published ports configured.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB 5: MOUNTS -->
    <div id="tabMounts" class="tab-pane-content d-none">
        <div class="fleptix-table-container">
            <table class="fleptix-table">
                <thead>
                    <tr>
                        <th>Mount Path (Destination)</th>
                        <th>Type / Permission</th>
                    </tr>
                </thead>
                <tbody>
                    @if (d.Mounts.Any())
                    {
                        @foreach (var mount in d.Mounts)
                        {
                            <tr>
                                <td class="font-mono fw-bold text-dark">@mount</td>
                                <td class="font-mono text-muted">Volume (ReadWrite)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-muted font-mono">No volume mounts found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB 6: FILES (Container Filesystem Browser) -->
    <div id="tabFiles" class="tab-pane-content d-none">
        <div class="bg-white border rounded overflow-hidden">
            <!-- Main Dual-Pane Browser: Left Tree (210px) + Right Data Table (Reclaimed Space) -->
            <div class="d-flex flex-column flex-md-row g-0">
                <!-- Left: Navigable Directory Tree (fixed 210px) -->
                <div class="border-end bg-light-subtle flex-shrink-0" style="width: 210px; max-height: 520px; overflow-y: auto;">
                    <div class="p-2 border-bottom text-muted fw-semibold font-mono d-flex align-items-center justify-content-between" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; height: 42px;">
                        <span>Directory Tree</span>
                        <i class="bi bi-diagram-2 text-secondary" style="font-size: 11px;"></i>
                    </div>
                    <div id="filesTreeRoot" class="p-1 font-mono" style="font-size: 11px;">
                        <div class="p-2 text-muted font-mono text-center">
                            <span class="spinner-border spinner-border-sm me-1" style="width: 12px; height: 12px;"></span> Loading root tree...
                        </div>
                    </div>
                </div>

                <!-- Right: Selected Directory File Table -->
                <div class="flex-grow-1 bg-white" style="min-width: 0; max-height: 520px; overflow-y: auto;">
                    <!-- Content Pane Header: Single Source of Truth for Current Location -->
                    <div class="p-2 border-bottom d-flex flex-wrap align-items-center justify-content-between bg-light gap-2" style="font-size: 11px; min-height: 42px;">
                        <div class="font-mono text-secondary d-flex align-items-center gap-2 overflow-hidden">
                            <span class="text-muted flex-shrink-0">Current Path:</span>
                            <span id="filesCurrentPathDisplay" class="fw-bold text-dark font-mono bg-white px-2 py-0 border rounded text-truncate" style="max-width: 340px;">/</span>
                            <span class="font-mono text-muted flex-shrink-0" id="filesItemCountDisplay" style="font-size: 10px;">
                                0 items
                            </span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <div class="position-relative" style="width: 190px;">
                                <i class="bi bi-search position-absolute text-muted" style="left: 8px; top: 50%; transform: translateY(-50%); font-size: 11px;"></i>
                                <input type="text" id="filesSearchInput" class="form-control form-control-sm ps-4 py-0 font-mono" placeholder="Filter in folder..." style="font-size: 11px; height: 26px;" oninput="filterFileTable(this.value)">
                            </div>
                            <button class="btn btn-sm btn-light border py-0 px-2 font-mono text-dark d-inline-flex align-items-center gap-1" style="font-size: 11px; height: 26px;" onclick="refreshCurrentFolder()" title="Refresh directory">
                                <i class="bi bi-arrow-clockwise"></i> Refresh
                            </button>
                        </div>
                    </div>

                    <div class="fleptix-table-container border-0 rounded-0">
                        <table class="fleptix-table" id="filesDataTable">
                            <thead>
                                <tr>
                                    <th style="min-width: 220px;">Name</th>
                                    <th style="width: 100px;">Type</th>
                                    <th style="width: 90px; text-align: right;">Size</th>
                                    <th style="width: 90px;">Mode</th>
                                    <th style="width: 140px;">Modified</th>
                                    <th style="width: 80px; text-align: right;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="filesTableBody">
                                <tr>
                                    <td colspan="6" class="text-center text-muted font-mono py-4">
                                        <span class="spinner-border spinner-border-sm me-1" style="width: 12px; height: 12px;"></span> Loading filesystem entries...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- File Preview & Download Modal -->
        <div class="modal fade" id="filePreviewModal" tabindex="-1" aria-labelledby="filePreviewModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content border shadow-sm">
                    <div class="modal-header py-2 px-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2 overflow-hidden">
                            <i class="bi bi-file-earmark-text text-primary fs-6"></i>
                            <span class="modal-title font-mono fw-bold text-dark text-truncate" id="filePreviewModalLabel" style="font-size: 12px;">/path/to/file</span>
                            <span id="filePreviewSizeBadge" class="badge bg-white text-secondary border font-mono" style="font-size: 10px;">0 B</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-light border py-0 px-2 font-mono text-dark d-inline-flex align-items-center gap-1" id="btnCopyFileContent" style="font-size: 11px; height: 24px;" onclick="copyCurrentFileContent()">
                                <i class="bi bi-clipboard"></i> Copy
                            </button>
                            <a id="btnDownloadFileLink" href="#" class="btn btn-sm btn-light border py-0 px-2 font-mono text-dark d-inline-flex align-items-center gap-1" style="font-size: 11px; height: 24px;">
                                <i class="bi bi-download"></i> Download
                            </a>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size: 10px;"></button>
                        </div>
                    </div>
                    <div class="modal-body p-0 bg-dark" id="filePreviewModalBody">
                        <div id="filePreviewLoading" class="p-4 text-center text-muted font-mono" style="font-size: 12px;">
                            <span class="spinner-border spinner-border-sm me-2" style="width: 14px; height: 14px;"></span>
                            Fetching file archive from container engine...
                        </div>
                        <div id="filePreviewContentContainer" class="d-none">
                            <pre id="filePreviewPre" class="m-0 p-3 font-mono text-light" style="font-size: 11px; line-height: 1.45; max-height: 500px; overflow-y: auto; white-space: pre-wrap; word-break: break-all;"></pre>
                        </div>
                        <div id="filePreviewBinaryContainer" class="d-none p-4 text-center font-mono">
                            <i class="bi bi-file-earmark-binary text-secondary fs-1 d-block mb-2"></i>
                            <div class="text-light fw-bold mb-1">Binary File</div>
                            <div class="text-muted mb-3" style="font-size: 11px;">This file contains binary data and cannot be displayed in text preview.</div>
                            <a id="btnDownloadBinaryLink" href="#" class="btn btn-sm text-white font-mono" style="background-color: var(--accent-navy); font-size: 11px; padding: 4px 14px;">
                                <i class="bi bi-download me-1"></i> Download File
                            </a>
                        </div>
                        <div id="filePreviewErrorContainer" class="d-none p-3 text-danger font-mono" style="font-size: 11px;">
                            <i class="bi bi-exclamation-octagon me-1"></i> <span id="filePreviewErrorText">Failed to load file.</span>
                        </div>
                    </div>
                    <div class="modal-footer py-1 px-3 bg-light border-top d-flex align-items-center justify-content-between font-mono" style="font-size: 10px;">
                        <span class="text-muted">Extracted via Docker <code>GetArchiveFromContainerAsync</code></span>
                        <button type="button" class="btn btn-sm btn-secondary py-0 px-2 font-mono" style="font-size: 11px;" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 7: TIME MACHINE SNAPSHOTS -->
    <div id="tabSnapshots" class="tab-pane-content d-none">
        @if (!Model.IsTimeMachineEnabled)
        {
            <div class="bg-white p-3 rounded border mb-3 shadow-xs font-mono" style="border-left: 3px solid #d97706 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-lock-fill" style="color: #d97706; font-size: 14px;"></i>
                        <span class="fw-bold text-dark" style="font-size: 13px;">Time Machine &bull; Fleptix Pro Feature</span>
                        <span class="badge font-mono" style="background-color: #fef3c7; color: #b45309; font-size: 9px; padding: 2px 6px; border: 1px solid #fde68a;">LOCKED</span>
                    </div>
                    <span class="text-muted" style="font-size: 10px;">Tier: Open-Core (Free / Developer)</span>
                </div>
                <p class="text-muted mb-3" style="font-size: 11px; line-height: 1.5;">
                    Atomic volume state tar-archiving, SHA-256 image digest verification, and sidecar runtime configuration rollback require a licensed edition of Fleptix. To enable Time Machine for container <code class="px-1 bg-light border rounded text-dark">@c.Name</code>, set <code class="px-1 bg-light border rounded text-dark">TIMEMACHINE_ENABLED=true</code> or update <code class="px-1 bg-light border rounded text-dark">TimeMachine:Enabled</code> in configuration.
                </p>
                <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="font-size: 11px;">
                    <a href="/Settings" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1 font-mono text-dark" style="font-size: 11px; padding: 3px 10px;">
                        <i class="bi bi-gear"></i> View Runtime License Settings
                    </a>
                    <span class="text-muted" style="font-size: 10px;">Feature key: <code>TimeMachine:Enabled</code> (Disabled)</span>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white p-3 rounded border mb-3 shadow-xs d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-warning fs-5"></i>
                        <span class="fw-bold text-dark font-mono" style="font-size: 13px;">Time Machine Snapshots</span>
                        <span class="badge font-mono ms-0.5" style="background-color: #fef3c7; color: #b45309; font-size: 8px; padding: 1px 3px; border: 1px solid #fde68a;">PRO</span>
                    </div>
                    <div class="text-muted font-mono mt-1" style="font-size: 11px;">
                        Captures atomic volume state tar-archives, image sha256 digests, and JSON runtime configuration manifests while freezing in-flight I/O.
                    </div>
                </div>
                <form method="post" asp-page-handler="Snapshot" asp-route-id="@c.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm text-white font-mono d-inline-flex align-items-center gap-1" style="background-color: var(--accent-navy); font-size: 11px; padding: 5px 14px;">
                        <i class="bi bi-camera"></i> Capture New Snapshot
                    </button>
                </form>
            </div>

            <!-- Automated Protection Panel -->
            <div class="fleptix-panel p-3 mb-3" id="panelContainerAutomatedProtection">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 pb-2.5 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check fs-5" id="iconProtectionStatus" style="color: var(--accent-navy);"></i>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-dark font-mono" style="font-size: 12.5px;">Automated Protection</span>
                                <span id="badgeEffectiveStatus" class="status-pill running"><span class="pill-dot"></span><span class="pill-text">Active</span></span>
                            </div>
                            <div id="textEffectivePolicy" class="text-muted font-mono" style="font-size: 11px;">
                                Loading effective policy...
                            </div>
                        </div>
                    </div>

                    <!-- 3-option control for the override (Use global default / Always on / Always off) -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted font-mono" style="font-size: 11px;">Override:</span>
                        <div class="btn-group btn-group-sm segmented-control" role="group" aria-label="Container auto-snapshot override">
                            <input type="radio" class="btn-check" name="radioContainerOverride" id="overrideUseGlobal" value="UseGlobalDefault" autocomplete="off">
                            <label class="btn btn-outline-secondary font-mono" for="overrideUseGlobal" style="font-size: 11px;">Use global default</label>

                            <input type="radio" class="btn-check" name="radioContainerOverride" id="overrideAlwaysOn" value="AlwaysOn" autocomplete="off">
                            <label class="btn btn-outline-secondary font-mono" for="overrideAlwaysOn" style="font-size: 11px;">Always on</label>

                            <input type="radio" class="btn-check" name="radioContainerOverride" id="overrideAlwaysOff" value="AlwaysOff" autocomplete="off">
                            <label class="btn btn-outline-secondary font-mono" for="overrideAlwaysOff" style="font-size: 11px;">Always off</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 pt-2.5">
                    <div class="d-flex flex-wrap align-items-center gap-3 font-mono" style="font-size: 11.5px;">
                        <div class="d-flex align-items-center gap-1.5">
                            <span class="text-muted">Total Storage:</span>
                            <span id="statTotalStorage" class="fw-bold text-dark">—</span>
                        </div>
                        <span class="text-muted">&bull;</span>
                        <div class="d-flex align-items-center gap-1.5">
                            <span class="text-muted">Snapshots:</span>
                            <span id="statSnapshotCount" class="fw-bold text-dark">—</span>
                        </div>
                        <span class="text-muted">&bull;</span>
                        <div class="d-flex align-items-center gap-1.5">
                            <span class="text-muted" id="statLastAutoSnapshot">Last auto-snapshot: —</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" id="btnPruneNow" class="btn btn-sm btn-outline-secondary font-mono d-inline-flex align-items-center gap-1.5 px-2.5 py-1" style="font-size: 11px;" title="Prune snapshots exceeding retention count or safety storage cap">
                            <i class="bi bi-scissors" id="iconPruneNow"></i>
                            <span id="textPruneNow">Prune now</span>
                            <span id="spinnerPruneNow" class="spinner-border spinner-border-sm d-none" style="width: 10px; height: 10px;" role="status"></span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="fleptix-table-container">
                <table class="fleptix-table">
                    <thead>
                        <tr>
                            <th style="width: 25%;">Snapshot ID</th>
                            <th style="width: 18%;">Captured Timestamp</th>
                            <th style="width: 18%;">Volume Archive (.tar)</th>
                            <th style="width: 18%;">Config Sidecar (.json)</th>
                            <th style="width: 11%;">Image Digest</th>
                            <th style="width: 10%;" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody id="snapshotsTableBody">
                        @if (Model.Snapshots.Any())
                        {
                            @foreach (var snap in Model.Snapshots)
                            {
                                <tr>
                                    <td class="font-mono fw-bold text-dark">
                                        <i class="bi bi-box-seam me-1 text-primary"></i>
                                        @snap.SnapshotId
                                    </td>
                                    <td class="font-mono text-muted">@snap.Timestamp.ToString("yyyy-MM-dd HH:mm:ss UTC")</td>
                                    <td class="font-mono text-dark">
                                        <span class="badge bg-light text-dark border">
                                            @(snap.ArchiveSizeBytes > 0 ? $"{(snap.ArchiveSizeBytes / 1024.0):F1} KB" : "Archive created")
                                        </span>
                                        <div class="text-muted text-truncate" style="font-size: 10px; max-width: 180px;" title="@snap.ArchivePath">
                                            @System.IO.Path.GetFileName(snap.ArchivePath)
                                        </div>
                                    </td>
                                    <td class="font-mono text-dark">
                                        <span class="badge bg-light text-success border">Sidecar Valid</span>
                                        <div class="text-muted text-truncate" style="font-size: 10px; max-width: 180px;" title="@snap.SidecarPath">
                                            @System.IO.Path.GetFileName(snap.SidecarPath)
                                        </div>
                                    </td>
                                    <td class="font-mono text-muted text-truncate" style="max-width: 120px;" title="@snap.ImageHash">
                                        @(string.IsNullOrEmpty(snap.ImageHash) ? "sha256:current" : (snap.ImageHash.Length > 15 ? snap.ImageHash[..15] + "..." : snap.ImageHash))
                                    </td>
                                    <td class="text-end font-mono">
                                        <form method="post" asp-page-handler="Restore" asp-route-id="@c.Id" asp-route-snapshotId="@snap.SnapshotId" class="d-inline" id="tableRestoreForm_@snap.SnapshotId">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-danger font-mono d-inline-flex align-items-center gap-1 py-0 px-2" style="font-size: 11px; height: 24px;" onclick="handleRestoreClick(event, '@c.Id', '@snap.SnapshotId', this)" title="Restore container state from this snapshot">
                                                <i class="bi bi-arrow-counterclockwise"></i> Restore
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-muted font-mono text-center p-4">
                                    <i class="bi bi-clock-history d-block fs-3 mb-1 text-secondary"></i>
                                    No Time Machine snapshots recorded for container '@c.Name' yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.CURRENT_CONTAINER_ID = '@c.Id';
        window.CURRENT_CONTAINER_SHORT_ID = '@c.ShortId';
        window.CURRENT_CONTAINER_STATE = '@c.State';

        async function handleSnapshotClick(e, containerId) {
            e.preventDefault();
            const btn = document.getElementById('btnSnapshot');
            const btnText = document.getElementById('snapshotBtnText');
            const spinner = document.getElementById('snapshotSpinner');

            if (btn) btn.disabled = true;
            if (btnText) btnText.textContent = 'Freezing...';
            if (spinner) spinner.classList.remove('d-none');

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const response = await fetch(`?handler=Snapshot&id=${encodeURIComponent(containerId)}`, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    }
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    window.showToast(result.message || 'Snapshot created successfully!');
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    window.showToast(result.message || 'Snapshot failed.', true);
                }
            } catch (err) {
                document.getElementById('snapshotForm')?.submit();
            } finally {
                if (btn) btn.disabled = false;
                if (btnText) btnText.textContent = 'Snapshot';
                if (spinner) spinner.classList.add('d-none');
            }
        }

        async function handleRestoreClick(e, containerId, snapshotId, btnEl) {
            e.preventDefault();
            if (!confirm(`Are you sure you want to restore container to snapshot '${snapshotId}'?\n\nTarget container will be stopped, volumes restored from tar-archive, image hash verified, and container restarted.`)) {
                return;
            }

            const originalHtml = btnEl ? btnEl.innerHTML : '';
            if (btnEl) {
                btnEl.disabled = true;
                btnEl.innerHTML = `<span class="spinner-border spinner-border-sm" style="width: 10px; height: 10px;" role="status"></span> Restoring...`;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const response = await fetch(`?handler=Restore&id=${encodeURIComponent(containerId)}&snapshotId=${encodeURIComponent(snapshotId)}`, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    }
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    window.showToast(result.message || 'Snapshot restored successfully!');
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    window.showToast(result.message || 'Restore failed.', true);
                    if (btnEl) {
                        btnEl.disabled = false;
                        btnEl.innerHTML = originalHtml;
                    }
                }
            } catch (err) {
                const form = document.getElementById(`tableRestoreForm_${snapshotId}`) || document.getElementById(`restoreForm_${snapshotId}`);
                if (form) form.submit();
            }
        }
    </script>
    <script src="~/js/details.js" asp-append-version="true"></script>
}

